# Copy this file to terraform.tfvars and replace the bucket suffix.
# S3 bucket names are globally unique, lowercase, and may contain hyphens.
aws_region        = "us-east-1"
project           = "ghost-production-aws"
state_bucket_name = "ghost-production-aws-tfstate-replace-with-unique-suffix"

# The repository trusted by GitHub Actions and the main root's remote-state key.
github_repository   = "owner/repository"
terraform_state_key = "ghost-production-aws/terraform.tfstate"
