# Copy to terraform.tfvars for local overrides (git-ignored).
aws_region = "us-east-1"
project    = "ghost-production-aws"

# Network layout: public ALB, private ECS, and isolated RDS.
vpc_cidr                 = "10.0.0.0/16"
public_subnet_cidrs      = ["10.0.0.0/24", "10.0.1.0/24"]
database_subnet_cidrs    = ["10.0.10.0/24", "10.0.11.0/24"]
application_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]

# Cloudflare remains authoritative for DNS. Before applying, request an ACM
# certificate matching this hostname in the same Region as the ALB, validate it
# using Cloudflare's DNS-only validation CNAME, and paste the issued ARN below.
domain_name         = "ghost.example.com"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"

# Cloudflare R2 is managed outside this AWS Terraform stack. Connect the custom
# hostname to the bucket in Cloudflare, disable its r2.dev URL, and store a
# bucket-scoped Object Read & Write token in AWS Secrets Manager as JSON with
# exact keys accessKeyId and secretAccessKey. Only its ARN belongs here.
cloudflare_account_id     = "0123456789abcdef0123456789abcdef"
r2_bucket_name            = "replace-with-r2-bucket-name"
r2_media_hostname         = "media.example.com"
r2_credentials_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:ghost-production-r2-replace-me"

# Resolve the immutable manifest digest for ghost:6.59.0-alpine, then replace
# the placeholder. A mutable tag is deliberately rejected by validation.
ghost_image = "ghost@sha256:789dee0d3e8c462ee75813e4f0fda31809a70c98097ded9059a4c72553db909c"

# This experimental stack is disposable, so RDS deletion protection is disabled
# by default. Set false for a longer-lived deployment that must resist deletion.
allow_data_destruction = true
